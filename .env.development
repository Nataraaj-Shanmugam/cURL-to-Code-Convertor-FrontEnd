# Local development (`npm run dev`). Vite loads this file automatically in dev mode.
# Points the app at a backend on localhost:8000. Put personal overrides in .env.development.local (git-ignored).
VITE_CURL_CRAFT_API_URL=http://localhost:8000
VITE_CURL_CRAFT_API_HEALTH_ENDPOINT=/api/health
VITE_CURL_CRAFT_API_PARSE_ENDPOINT=/api/parse
VITE_CURL_CRAFT_API_GENERATE_ENDPOINT=/api/generate-from-parsed
VITE_CURL_CRAFT_API_FEEDBACK_ENDPOINT=/api/feedback

NODE_ENV=development
